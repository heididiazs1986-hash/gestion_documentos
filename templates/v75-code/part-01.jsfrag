  function v75Data(){
    const v={...(typeof data==='function'?data():{})};
    v._empresa_inmel=APPLUS;v._empresa_applus=APPLUS;v._empresa=APPLUS;v._aliado=APPLUS;
    return v;
  }
  function normalizeChoice(name,val){
    let s=sanitizePdfText(val??'').trim();
    if(!s)return s;
    if(name==='2 tipo persona')return /^jur/i.test(s)?'jurídica':'natural';
    if(name==='1 zona')return /^rur/i.test(s)?'rural':'urbana';
    if(name==='Red electrica cercana')return /^n/i.test(s)?'No':'Si';
    return s;
  }