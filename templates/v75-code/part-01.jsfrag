RTS;i++){
        const name=String(i).padStart(2,'0');
        parts.push((await fetchText(`./templates/E1/part-${name}.b64?v=${VERSION}-${TEMPLATE_VERSION}`)).replace(/\s+/g,''));
      }
      bytes=b64ToUint8(parts.join(''));
    }else{
      const files={E6:'E6.pdf',AR:'AR.pdf',DJ:'DJ.pdf',RETIE:'RETIE.pdf',TD:'Constancia_TD.pdf'};
      const file=files[doc];
      if(!file)throw new Error('Plantilla no configurada: '+doc);
      bytes=await fetchBytes(`./templates/${file}?v=${VERSION}-${TEMPLATE_VERSION}`);
    }
    if(!bytes?.length)throw new Error('Plantilla vaía: '+doc);
    binaryTemplateCache.set(doc,bytes.slice());
    return bytes.slice();
  }

